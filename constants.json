{
  "domains": {
    "carsharing": {
      "base_url": "http://localhost:8000",
      "collection_name": "Carsharing API Test Suite",
      "env_vars": {
        "customerId":    "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
        "paymentId":     "99999999-9999-9999-9999-999999999999",
        "reservationId": "cccccccc-0000-0000-0000-cccccccccccc"
      },
      "scenarios": {
        "UC_001": {
          "files": ["UC_001_SearchAvailableCars"],
