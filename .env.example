# Copy this file to .env in the project root before running the CLI.
# CLI --model / script -Model overrides OLLAMA_MODEL.

# Local Ollama (start Ollama and run: ollama pull qwen3.8:27b)
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=900
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=32768
OLLAMA_THINK=false
OLLAMA_SEED=42

# Optional OpenRouter: use --llm openrouter / -Llm openrouter.
# Set your own key in .env; never commit API keys.
# Choose the OpenRouter model with --model / -Model.
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
