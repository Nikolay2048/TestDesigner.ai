# The local provider is the default.
LLM_PROVIDER=local

# Local Ollama model.
OLLAMA_MODEL=qwen3.5:27b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=32768
OLLAMA_REASONING=false

# OpenRouter model and secret. Never commit a real key.
OPENROUTER_MODEL=qwen/qwen3-32b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Shared invocation settings.
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=900
LLM_SEED=42
LLM_MAX_RETRIES=2
