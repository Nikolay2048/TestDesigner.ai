{
  "scenario_name": "UC-001. Создание и отмена бронирования автомобиля",
  "description": "Создание бронирования автомобиля в системе каршеринга с последующей отменой бронирования.",
  "steps": [
    {
      "step_num": 1,
      "name": "Получение списка доступных автомобилей",
      "description": "Пользователь инициирует запрос на получение списка доступных автомобилей.",
      "method": "GET",
      "path": "/v1/vehicles/available",
      "path_params": {},
      "query_params": {
        "city": "{{city}}"
      },
      "body": null,
      "expected_status_code": 200,
      "extract_vars": {
        "vehicleId": "$.items[0].vehicleId"
      },
      "assertions": []
    },
    {
      "step_num": 2,
      "name": "Создание бронирования",
      "description": "Система принимает запрос на создание бронирования.",
      "method": "POST",
      "path": "/v1/bookings",
      "path_params": {},
      "query_params": null,
      "body": {
        "userId": "{{user_id}}",
        "vehicleId": "{{vehicleId}}",
        "startDate": "{{startDate}}"
      },
      "expected_status_code": 201,
      "extract_vars": {
        "bookingId": "$.bookingId"
      },
      "assertions": []
    },
    {
      "step_num": 3,
      "name": "Получение информации о бронировании",
      "description": "После успешного создания бронирования пользователь инициирует запрос на получение информации по идентификатору бронирования.",
      "method": "GET",
      "path": "/v1/bookings/{bookingId}",
      "path_params": {
        "bookingId": "{{bookingId}}"
      },
      "query_params": null,
      "body": null,
      "expected_status_code": 200,
      "extract_vars": {},
      "assertions": [
        {
          "description": "Booking status is CREATED.",
          "path": "$.status",
          "operator": "eq",
          "expected": "CREATED"
        }
      ]
    },
    {
      "step_num": 4,
      "name": "Отмена бронирования",
      "description": "Пользователь инициирует отмену ранее созданного бронирования.",
      "method": "POST",
      "path": "/v1/bookings/{bookingId}/cancel",
      "path_params": {
        "bookingId": "{{bookingId}}"
      },
      "query_params": null,
      "body": null,
      "expected_status_code": 200,
      "extract_vars": {},
      "assertions": [
        {
          "description": "Booking status is CANCELLED.",
          "path": "$.status",
          "operator": "eq",
          "expected": "CANCELLED"
        }
      ]
    },
    {
      "step_num": 5,
      "name": "Проверка итогового состояния бронирования",
      "description": "Пользователь повторно запрашивает информацию о бронировании.",
      "method": "GET",
      "path": "/v1/bookings/{bookingId}",
      "path_params": {
        "bookingId": "{{bookingId}}"
      },
      "query_params": null,
      "body": null,
      "expected_status_code": 200,
      "extract_vars": {},
      "assertions": [
        {
          "description": "Booking status is CANCELLED.",
          "path": "$.status",
          "operator": "eq",
          "expected": "CANCELLED"
        }
      ]
    }
  ]
}